config_snapshots/
notebooks/
logs/
*.csv

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- backups ---
*-bak
*.bak
*.v1-bak
studio_settings.json

# update logs
deploy/logs/*.log
deploy/logs/latest.log
deploy/logs/.reqhash
deploy/update.conf
monitor_settings.json
