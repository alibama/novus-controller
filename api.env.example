# api.env.example
# Copy to api.env (install.sh generates one for you with a random token) and
# load it into the kiln-dashboard and kiln-api services — the systemd units
# in deploy/ already reference it via EnvironmentFile=-.../api.env, and
# docker-compose.yml passes it with env_file.
#
# IMPORTANT: api.env contains a secret — it's gitignored. chmod 600 it.

# Bearer token required for the API's POST endpoints (anything that writes:
# queuing commands, submitting notes, etc.). Clients send it as
#   Authorization: Bearer <token>
# GET endpoints (the open data) stay public and need no token.
# Generate one with:  openssl rand -hex 32
API_WRITE_TOKEN=

# Optional. The public https URL the API is reachable at from outside the LAN
# (e.g. a Tailscale Funnel URL like https://kiln-host.tailnet-name.ts.net).
# Shown on the dashboard's Open Data page so visitors know where to point
# their tools. Leave empty if you only use the API on the LAN.
# API_PUBLIC_URL=

# Optional. 1 (default) lets clients that present API_WRITE_TOKEN queue
# run / stop / setpoint commands for the controllers; 0 makes the API
# strictly read-only even for token holders.
# API_ALLOW_CONTROL=1
