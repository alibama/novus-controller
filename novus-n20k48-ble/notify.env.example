# notify.env.example
# Copy to notify.env, fill in the channels you want, and load it into the
# kiln-dashboard service (see SETUP.md). Set ONLY the channels you use;
# the rest are skipped. Configure more than one for redundancy.
#
# IMPORTANT: notify.env contains secrets — it's gitignored. chmod 600 it.

# --- Telegram (recommended primary: free, easy, supports a group) ---
# 1. In Telegram, message @BotFather -> /newbot -> get the token.
# 2. Add the bot to a group (you + your other guy), or DM it.
# 3. Get the chat id: message the bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and read chat.id
#    (group ids are negative numbers).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy (free, push to phone app, self-hostable on your tailnet) ---
# Install the ntfy app, subscribe to a hard-to-guess topic name, set it here.
# For a self-hosted server set NTFY_SERVER and (if protected) NTFY_TOKEN.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Twilio SMS (real SMS — best for the wake-you-up / low-phone-user case) ---
# Costs per message; requires a Twilio account and a purchased number.
# TWILIO_TO can be a comma-separated list of recipients.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
