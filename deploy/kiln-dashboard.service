# !!! DO NOT copy this file verbatim — it contains PLACEHOLDERS.
# 'youruser' and '/home/youruser/novus-n20k48-ble' are NOT real; installing
# as-is fails with status=217/USER. Use the installer, which fills in this
# machine's real path and user:   sudo bash deploy/install-services.sh
#
# /etc/systemd/system/kiln-dashboard.service
#
# Runs the Streamlit dashboard (which also logs to CSV) as a SYSTEM service.
# Because it's a system service on multi-user.target, it starts at boot with
# NO login required. It binds to 0.0.0.0 so other devices on the LAN (phones,
# the shop PC) can open it; the app itself is password-gated
# (.streamlit/secrets.toml -> dashboard_password). Put Tailscale Serve/Funnel
# or a reverse proxy in front of it for access from outside the LAN.
#
# Install: `sudo bash deploy/install-services.sh --enable` (or see SETUP.md).

[Unit]
Description=Novus kiln dashboard (Streamlit + BLE, with logging)
After=network-online.target bluetooth.service
Wants=network-online.target
Requires=bluetooth.service

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/novus-n20k48-ble
Environment="PATH=/home/youruser/novus-n20k48-ble/.venv/bin:/usr/local/bin:/usr/bin:/bin"
# Optional env files (the leading '-' means "skip silently if missing"):
#   notify.env  Telegram / ntfy / Twilio credentials (see notify.env.example)
#   api.env     API_WRITE_TOKEN / API_PUBLIC_URL / API_ALLOW_CONTROL (see api.env.example)
EnvironmentFile=-/home/youruser/novus-n20k48-ble/notify.env
EnvironmentFile=-/home/youruser/novus-n20k48-ble/api.env
# headless=true stops Streamlit trying to open a browser or prompt for telemetry.
ExecStart=/home/youruser/novus-n20k48-ble/.venv/bin/streamlit run kiln_dashboard.py \
          --server.address 0.0.0.0 \
          --server.port 8501 \
          --server.headless true

# Keep it alive no matter what. StartLimitIntervalSec=0 means systemd will
# never stop retrying, even after many rapid failures (e.g. kilns powered off).
Restart=always
RestartSec=10
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
